# Backend API Configuration - EXAMPLE FILE
# Copy this file to .env and update with your local backend URLs
# Note: .env is in .gitignore and should never be committed

# Main API Base URL (for employees, audit, dashboard endpoints)
NG_APP_API_URL=http://localhost:3000/api

# Authentication Service URL (for login, token refresh)
NG_APP_AUTH_URL=http://localhost:3001/auth

# Backend Status (set to 'true' when backend is ready)
NG_APP_USE_REAL_BACKEND=false
